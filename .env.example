# MongoDB Atlas or local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/atelier-commerce
PORT=4000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
STORE_NAME=Atelier
STORE_LOGO_URL=
STORE_PRIMARY_COLOR=#353d32
STORE_ACCENT_COLOR=#b87860
STORE_CURRENCY=INR
TAX_RATE=0.05
SHIPPING_FLAT=99
FREE_SHIPPING_FROM=4999
STORE_EMAIL=hello@atelier.store
STORE_PHONE=+91 98765 43210
STORE_ADDRESS=Mumbai, India
STORE_INSTAGRAM_URL=https://www.instagram.com/
# Optional local development administrator; set both email and password before running npm run seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=Store Admin
SEED_ADMIN_PASSWORD=
# Optional SMTP server for password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Optional integrations; checkout remains COD-ready without these keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
